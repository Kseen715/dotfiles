# CopyQ theme template (§6b) -> ~/.config/copyq/themes/osr.ini, selected by the
# `style` key copyq.conf. CopyQ's item list is its whole UI, and it defaults to
# the Qt palette - which under i3 is whatever qt5ct says, i.e. grey.
[Theme]
bg={{background}}
fg={{foreground}}
alt_bg={{panel_background}}
sel_bg={{selection_background}}
sel_fg={{selection_foreground}}
cur_item_bg={{accent}}
cur_item_fg={{background}}
find_bg={{accent_yellow}}
find_fg={{background}}
notes_bg={{panel_background}}
notes_fg={{text_faint}}
num_fg={{text_muted}}
edit_bg={{panel_background}}
edit_fg={{foreground}}
font="{{mono_font}},10"
show_number=true
show_scrollbars=true

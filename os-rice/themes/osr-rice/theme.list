# os-rice/themes/osr-rice/theme.list — a Windows-native palette, same
# `key: value` shape as every other themes/<name>/theme.list (this is not a
# separate Windows-only format -- see lib/theme_list.c/theme_render.c). It
# lives in the same themes/ tree as every Linux theme now (ingested from the
# now-retired windows-rice/themes/osr-rice/, see PLAN_UNIVERSAL.md decision
# 8), so it renders through the exact same code path as nord/gruvbox/etc.
# Values match ../../wezterm/wezterm-theme.toml, the dotfiles-level default
# WezTerm already used before any theme rendering existed. Not install.exe's
# default theme (that's still "xin", see install.c's OSR_DEFAULT_THEME) but
# still the only theme with an oh-my-posh prompt (config/oh-my-posh/), so
# modules.c's module_oh_my_posh falls back to it for any theme that ships
# none of its own.
#
# Every other theme (nord, gruvbox, catppuccin, glass, rosemary, xin) also
# works as-is for the Windows modules: modules.c renders their real
# wezterm-theme.toml.tmpl/config.jsonc.tmpl against their real theme.list,
# not a hand-copied approximation of them.

display: OSR Rice
description: Windows-native palette (matches WezTerm's dotfiles default)
polarity: dark
session: any

# Toolkit and font names. Not colors, but the same kind of thing: what a theme
# picks, that a per-app template drops into a settings file. This theme is
# Windows-native in origin but lives in the shared themes/ tree, so it carries
# the same block every other theme does - otherwise the Linux layers (gtkrc,
# settings.ini, xsettingsd, qt5ct/qt6ct) render with the placeholder visible.
# Values are the tree's defaults; the mono font is the one ../../wezterm's
# .wezterm.lua already assumes (JetBrainsMono Nerd Font).
gtk_theme: Adwaita-dark
icon_theme: Papirus-Dark
cursor_theme: Adwaita
cursor_size: 24
ui_font: Noto Sans 10
ui_font_family: Noto Sans
ui_font_size: 10
mono_font: JetBrainsMono Nerd Font
# GNOME 47+ takes a NAMED accent, not a hex: blue teal green yellow orange
# red pink purple slate. Nearest name to this theme's accent (#3292dc).
gnome_accent: blue
gtk_decoration_layout: menu:minimize,maximize,close
gtk_animations: 1

# --- the window -----------------------------------------------------------
color: background            #181818
color: foreground            #ffffff
color: cursor                #ffffff
color: selection_background  #303030
color: selection_foreground  #ffffff
color: background_opacity     0.9
color: background_blur        0

# Three shades off the background, for toolkits that ask for a full ramp (Qt's
# Dark/Mid/Shadow roles). Derived from the background when the theme was
# written, not at render time - a theme may retune any of them by hand. This
# background is #181818, the same as glass/xin, so the ramp off it is too.
color: background_sunken     #111111
color: surface_mid           #272727
color: shadow                #0d0d0d

# --- the 16 ANSI slots ------------------------------------------------------
color: ansi_black            #1e1e1e
color: ansi_red              #be0f17
color: ansi_green            #338716
color: ansi_yellow           #d4c310
color: ansi_blue             #185b8f
color: ansi_magenta          #a12b84
color: ansi_cyan             #578f8d
color: ansi_white            #bbbbbb
color: ansi_bright_black     #525252
color: ansi_bright_red       #f0424b
color: ansi_bright_green     #55dc28
color: ansi_bright_yellow    #f3e659
color: ansi_bright_blue      #3292dc
color: ansi_bright_magenta   #d45eb7
color: ansi_bright_cyan      #90bbba
color: ansi_bright_white     #ededed

# --- TUI chrome --------------------------------------------------------------
color: text_primary          #ffffff
color: text_metadata         #a12b84
color: text_muted            #525252
color: text_faint            #525252
color: panel_background      #1e1e1e
color: border                #525252
color: highlight             #be0f17
color: accent_red            #be0f17
color: accent_green          #338716
color: accent_yellow         #d4c310
color: accent_blue           #185b8f
color: accent_magenta        #a12b84
color: accent_cyan           #90bbba
color: accent_orange         #d4c310
color: urgent                #be0f17
color: box_cpu                #578f8d
color: box_memory             #338716
color: box_network            #a12b84
color: box_process            #185b8f
color: gradient_mid           #d4c310
color: gradient_peak          #be0f17

# --- semantic roles -----------------------------------------------------------
color: surface                #1e1e1e
color: text_dim                #525252
color: accent                  #3292dc
color: success                  #338716
color: error                     #be0f17
color: warning                    #d4c310
color: prompt_secondary            #ededed

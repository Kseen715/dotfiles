# gruvbox (dark, medium contrast) btop theme — rice-owned theme layer (90-*,
# swapped on rice switch, §6). Same 16 colors as this rice's ghostty palette.

# Main background, empty for terminal default; ignored while btop.conf keeps
# theme_background = False (transparent background).
theme[main_bg]="#282828"
theme[main_fg]="#ebdbb2"
theme[title]="#ebdbb2"
theme[hi_fg]="#fb4934"
theme[selected_bg]="#504945"
theme[selected_fg]="#ebdbb2"
theme[inactive_fg]="#928374"
theme[graph_text]="#a89984"
theme[meter_bg]="#282828"
theme[proc_misc]="#8ec07c"

# Box outlines
theme[cpu_box]="#8ec07c"
theme[mem_box]="#b8bb26"
theme[net_box]="#d3869b"
theme[proc_box]="#83a598"
theme[div_line]="#928374"

# Temperature graph
theme[temp_start]="#98971a"
theme[temp_mid]="#d79921"
theme[temp_end]="#cc241d"

# CPU graph
theme[cpu_start]="#689d6a"
theme[cpu_mid]="#fabd2f"
theme[cpu_end]="#fb4934"

# Mem/disk meters
theme[free_start]="#b8bb26"
theme[free_mid]=""
theme[free_end]="#98971a"
theme[cached_start]="#83a598"
theme[cached_mid]=""
theme[cached_end]="#458588"
theme[available_start]="#fabd2f"
theme[available_mid]=""
theme[available_end]="#d79921"
theme[used_start]="#fb4934"
theme[used_mid]=""
theme[used_end]="#cc241d"

# Net graphs
theme[download_start]="#8ec07c"
theme[download_mid]=""
theme[download_end]="#689d6a"
theme[upload_start]="#d3869b"
theme[upload_mid]=""
theme[upload_end]="#b16286"

# Process list gradient
theme[process_start]="#b8bb26"
theme[process_mid]="#fabd2f"
theme[process_end]="#fb4934"

# betterlockscreenrc — rice-owned lock screen colors (i3-rosemary).
# Swapped on rice switch (§6). betterlockscreen is a wrapper around
# i3lock-color, so these are i3lock-color's argument colors in RRGGBBAA.
#
# The wallpaper cache is primed by modules/i3lock.sh; `betterlockscreen -u <img>`
# rebuilds it after changing the image.

display_on=0
span_image=false
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
# Matched to the glass rice's hyprlock background (blur_passes 3, brightness
# .6): a softer, deeper blur than the default, so the oversized clock has
# something quiet to sit on rather than a legible desktop.
dim_level=45
blur_level=3
pixel_scale=10,1000
solid_color=1c1f20
wallpaper_cmd="feh --no-fehbg --bg-fill"
quiet=false

# theme
# Fully transparent, and that is load-bearing rather than cosmetic:
# betterlockscreen BAKES this rectangle into the cached lock image with
# ImageMagick, at the position its own default layout puts the indicator
# (bottom-left). custom-pre.sh moves the indicator to the centre, so a visible
# loginbox is left stranded in the corner with nothing in it. Re-run
# `betterlockscreen -u <image>` after changing this - it only takes effect when
# the cache is rebuilt.
loginbox=00000000
loginshadow=00000000
# Blank: the greeter label is removed in custom-pre.sh. Kept as a key rather
# than deleted because betterlockscreen references it unconditionally.
locktext=""
font="JetBrainsMono Nerd Font"
ringcolor=d98caeff
ringvercolor=8fb3b0ff
ringwrongcolor=e2655eff
insidecolor=24282a66
insidevercolor=24282a99
insidewrongcolor=e2655e33
separatorcolor=00000000
keyhlcolor=f15495ff
bshlcolor=d3877aff
timecolor=e8dfe1ff
greetercolor=b3a8abff
layoutcolor=8d8386ff
verifcolor=8fb3b0ff
wrongcolor=e2655eff
modifcolor=d9b48fff
bgcolor=1c1f20ff
time_format="%H:%M"
veriftext="checking..."
wrongtext="nope"

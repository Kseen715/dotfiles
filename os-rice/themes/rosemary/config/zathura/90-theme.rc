# 90-theme.rc — rice-owned zathura colors (void-i3-rosemuted). Included by the
# dotfiles-owned zathurarc, so anything here wins. Swapped on switch (§6).

set font "JetBrainsMono Nerd Font 10"

set default-bg              "#1c1f20"
set default-fg              "#e8dfe1"
set statusbar-bg            "#24282a"
set statusbar-fg            "#e8dfe1"
set inputbar-bg             "#24282a"
set inputbar-fg             "#d98cae"
set notification-bg         "#24282a"
set notification-fg         "#e8dfe1"
set notification-error-bg   "#e2655e"
set notification-error-fg   "#1c1f20"
set notification-warning-bg "#d9b48f"
set notification-warning-fg "#1c1f20"
set completion-bg           "#24282a"
set completion-fg           "#b3a8ab"
set completion-group-bg     "#1c1f20"
set completion-group-fg     "#8d8386"
set completion-highlight-bg "#d98cae"
set completion-highlight-fg "#1c1f20"
set index-bg                "#1c1f20"
set index-fg                "#e8dfe1"
set index-active-bg         "#d98cae"
set index-active-fg         "#1c1f20"
set highlight-color         "#d9b48f"
set highlight-active-color  "#d98cae"
set render-loading-bg       "#1c1f20"
set render-loading-fg       "#8d8386"

# recolor: night mode that keeps the palette instead of inverting to grey.
set recolor-lightcolor      "#1c1f20"
set recolor-darkcolor       "#e8dfe1"
set recolor                 true
set recolor-keephue         true

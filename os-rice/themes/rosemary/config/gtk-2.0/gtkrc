# ~/.gtkrc-2.0 — rice-owned (void-i3-rosemuted). Still needed: a surprising
# number of long-lived X11 apps (GIMP 2, Pidgin, older Java-GTK bridges) are
# GTK2 and read nothing else. Swapped on rice switch (§6).

gtk-theme-name="Adwaita-dark"
gtk-icon-theme-name="Papirus-Dark"
gtk-cursor-theme-name="Vanilla-DMZ"
gtk-cursor-theme-size=24
gtk-font-name="Noto Sans 10"
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
gtk-menu-images=1
gtk-button-images=1

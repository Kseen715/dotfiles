# catppuccin (mocha) btop theme — rice-owned theme layer (90-*, swapped on rice
# switch, §6). Same 16 colors as this rice's ghostty palette.

# Main background, empty for terminal default; ignored while btop.conf keeps
# theme_background = False (transparent background).
theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#a6adc8"
theme[hi_fg]="#f38ba8"
theme[selected_bg]="#585b70"
theme[selected_fg]="#cdd6f4"
theme[inactive_fg]="#585b70"
theme[graph_text]="#bac2de"
theme[meter_bg]="#45475a"
theme[proc_misc]="#94e2d5"

# Box outlines
theme[cpu_box]="#94e2d5"
theme[mem_box]="#a6e3a1"
theme[net_box]="#f5c2e7"
theme[proc_box]="#89b4fa"
theme[div_line]="#585b70"

# Temperature graph
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph
theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Mem/disk meters
theme[free_start]="#a6e3a1"
theme[free_mid]=""
theme[free_end]="#a6e3a1"
theme[cached_start]="#89b4fa"
theme[cached_mid]=""
theme[cached_end]="#89b4fa"
theme[available_start]="#f9e2af"
theme[available_mid]=""
theme[available_end]="#f9e2af"
theme[used_start]="#f38ba8"
theme[used_mid]=""
theme[used_end]="#f38ba8"

# Net graphs
theme[download_start]="#94e2d5"
theme[download_mid]=""
theme[download_end]="#94e2d5"
theme[upload_start]="#f5c2e7"
theme[upload_mid]=""
theme[upload_end]="#f5c2e7"

# Process list gradient
theme[process_start]="#a6e3a1"
theme[process_mid]="#f9e2af"
theme[process_end]="#f38ba8"

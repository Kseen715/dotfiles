#!/bin/sh
# osr — front-end CLI for the os-rice harness.
#
#   osr install <rice> [--theme <t>] [--user <name>] [--verbose]
#                                                    full install of a rice
#   osr switch  <rice> [--user <name>] [--verbose]   move to a rice (§6):
#                                                    additive packages, the
#                                                    theme-owned 90-* config and
#                                                    wallpaper are replaced;
#                                                    00-env / aliases / installed
#                                                    packages are left untouched.
#   osr theme   [<name>] [--no-reload]               apply a THEME only (§6a):
#                                                    rewires the 90-* layers and
#                                                    reloads the running apps.
#                                                    No packages, no sudo, no
#                                                    network - this is the one
#                                                    to bind to a hotkey. With
#                                                    no name, prints the current
#                                                    theme.
#   osr wallpaper [<path>]                           set (or print) the wallpaper
#                                                    for the current theme.
#   osr module  <name>... [--theme <t>]              install module(s), no rice;
#                                                    --theme picks which theme
#                                                    supplies the 90-* layers
#                                                    (omitted: the theme already
#                                                    applied, else the picker,
#                                                    else the default if no TTY).
#   osr list                                         list available rices
#   osr themes                                       list available themes
#   osr modules                                      list available modules
#   osr benchmark cpu [--seconds N] [--json]         measure the CPU: single- and
#                     [--save NAME] [--compare NAME]  all-core throughput, package
#                                                    power under load and idle,
#                                                    peak temp and clock. Short
#                                                    output by default; installs
#                                                    its workload if missing.
#   osr undervolt cpu <verb>                         CPU voltage offsets. Start
#                                                    with `probe`: it never
#                                                    writes and tells you
#                                                    whether this machine can
#                                                    be undervolted at all.
#   osr test                                         run the test suite
#   osr --check                                      report what a barebone box
#                                                    is missing, then exit
#   OSR_C_MODULE_BACKEND=runtime osr module <name>    compile/load C modules on
#                                                    demand; default is static
#                                                    (OSR_MODULE_CC overrides cc)
#
# It is also the barebone entry point. Piped from curl there is no checkout
# yet, so it installs git and a compiler, clones the repo and re-execs the
# copy inside it with the same arguments:
#
#   curl -fsSL https://raw.githubusercontent.com/Kseen715/dotfiles/main/os-rice/osr \
#       | sh -s -- install gruvbox
#
# switch and install share one idempotent engine (`osr install run`, which
# install.sh is a shim over -- it delegates here): because installs never uninstall and install_layer
# overwrites only os-rice-owned layers, "move A -> B" is just applying B on top
# of A. `theme` is the same engine again with every mutating verb neutralized
# (osr_theme_only, lib/module.h) - one code path, three verbs.
set -eu

# --- self-bootstrap: the `curl | sh` entry point ------------------------------
#
# This is the one file that can run BEFORE the tree it drives exists. Piped
# from curl, $0 is `sh` and there is no checkout anywhere, so the detached case
# installs git and a C compiler, clones the repo, and re-execs the copy inside
# it with the arguments it was given.
#
#   sh -s -- --check      report the detected downloader, pkg manager, git, cc
#
# Env overrides:
#   OSR_REPO_URL   git URL of the dotfiles repo (default below)
#   OSR_DEST       where to clone (default: ~/.local/share/os-rice-dotfiles)
#
# It lives here rather than in a bootstrap.sh beside it for the same reason
# install.sh and wallpaper.sh delegate here: the URL people are told to pipe
# should be the same program they run afterwards, so there is no second entry
# point to keep in step with this one. Nothing in this block compiles -- it
# runs before a toolchain is a given, and its whole job is to make one present
# (archive-decisions A2).

# Detached when this file is running without the tree it drives around it:
# piped from curl, or copied somewhere on its own. Two independent signals,
# because either one alone has a false positive:
#
#   $0 is a readable file -- piped from a pipe there is no file at all, $0 is
#       just the shell's own name ("sh"), so dirname lands on the cwd;
#   lib/ sits beside it -- a lone copy of this file has a real $0 and a
#       perfectly good dirname, and still drives nothing.
#
# The marker is lib/ rather than a build input like nob.c because the question
# is whether the rest of THIS script can find what it needs, not whether the
# directory is a source checkout: the test sandboxes assemble a root out of
# symlinks with no build inputs in it, and they are checkouts for this purpose.
# Run from a real one, neither the clone nor the installs below happen.
OSR_SELF_DIR=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || OSR_SELF_DIR=
osr_detached() {
    [ -n "$OSR_SELF_DIR" ] && [ -f "$0" ] && [ -d "$OSR_SELF_DIR/lib" ] && return 1
    return 0
}

_bs_log() { printf '[bootstrap] %s\n' "$*"; }
_bs_die() { printf '[bootstrap] error: %s\n' "$*" >&2; exit 1; }

# _bs_have_cc -- is there a C compiler? A precondition, not a nicety: the
# harness-core block further down builds build/osr out of nob.c on a fresh
# checkout, so a box that got git and nothing else clones fine and then dies
# one line later.
_bs_have_cc() {
    # $CC may be a command line ("zig cc"), so probe its first word.
    # shellcheck disable=SC2086  # deliberate split, see above
    set -- ${CC:-cc}
    command -v "$1" >/dev/null 2>&1 ||
        command -v cc >/dev/null 2>&1 ||
        command -v gcc >/dev/null 2>&1 ||
        command -v clang >/dev/null 2>&1
}

if osr_detached; then
    OSR_REPO_URL=${OSR_REPO_URL:-https://github.com/Kseen715/dotfiles.git}
    OSR_DEST=${OSR_DEST:-"$HOME/.local/share/os-rice-dotfiles"}

    # _bs_downloader -- echo curl | wget | busybox-wget | "" (barebone-first).
    _bs_downloader() {
        if command -v curl >/dev/null 2>&1; then
            echo curl
        elif command -v wget >/dev/null 2>&1; then
            echo wget
        elif command -v busybox >/dev/null 2>&1 && busybox wget --help >/dev/null 2>&1; then
            echo busybox-wget
        else
            echo ""
        fi
    }

    # _bs_pkg -- echo the native package manager, for pulling git and cc.
    _bs_pkg() {
        for _p in apt-get dnf pacman apk xbps-install emerge; do
            if command -v "$_p" >/dev/null 2>&1; then
                case "$_p" in
                    apt-get) echo apt ;;
                    xbps-install) echo xbps ;;
                    emerge) echo portage ;;
                    *) echo "$_p" ;;
                esac
                return 0
            fi
        done
        echo ""
    }

    _bs_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

    # _bs_add <apt> <dnf> <pacman> <apk> <xbps> <portage> -- one package, named
    # per manager. Only two things are ever pulled here (git, a compiler), so a
    # positional row beats a second copy of the case.
    _bs_add() {
        case "$(_bs_pkg)" in
            apt)     _bs_root env DEBIAN_FRONTEND=noninteractive apt-get update -q &&
                     _bs_root env DEBIAN_FRONTEND=noninteractive apt-get install -y "$1" ;;
            dnf)     _bs_root dnf install -y "$2" ;;
            pacman)  _bs_root pacman -Sy --needed --noconfirm "$3" ;;
            apk)     _bs_root apk add "$4" ;;
            xbps)    _bs_root xbps-install -y "$5" ;;
            portage) _bs_root emerge --quiet --noreplace --getbinpkg "$6" ;;
            *)       _bs_die "no package manager found to install $1" ;;
        esac
    }

    if [ "${1:-}" = "--check" ]; then
        _dl=$(_bs_downloader)
        [ -n "$_dl" ] || _bs_die "no downloader found (need curl, wget, or busybox)"
        _bs_log "downloader: $_dl"
        _bs_log "pkg manager: $(_bs_pkg)"
        if command -v git >/dev/null 2>&1; then _bs_log "git: present"; else _bs_log "git: missing (would install)"; fi
        if _bs_have_cc; then _bs_log "cc: present"; else _bs_log "cc: missing (would install)"; fi
        exit 0
    fi

    [ -n "$(_bs_downloader)" ] || _bs_die "no downloader found (need curl, wget, or busybox)"

    if ! command -v git >/dev/null 2>&1; then
        _bs_log "git not found - installing via $(_bs_pkg)"
        _bs_add git git git git git dev-vcs/git
    fi
    if ! _bs_have_cc; then
        _bs_log "no C compiler found - installing via $(_bs_pkg)"
        _bs_add build-essential gcc base-devel build-base gcc sys-devel/gcc
    fi

    if [ -d "$OSR_DEST/.git" ]; then
        _bs_log "updating existing clone at $OSR_DEST"
        git -C "$OSR_DEST" pull --ff-only
    else
        _bs_log "cloning $OSR_REPO_URL -> $OSR_DEST"
        mkdir -p "$(dirname -- "$OSR_DEST")"
        git clone --depth 1 "$OSR_REPO_URL" "$OSR_DEST"
    fi

    _bs_log "handing off to $OSR_DEST/os-rice/osr"
    exec sh "$OSR_DEST/os-rice/osr" "$@"
fi

# --check inside a checkout is the same question, answered by the same code
# path -- re-exec nothing, just report and leave.
if [ "${1:-}" = "--check" ]; then
    _bs_log "checkout: $OSR_SELF_DIR"
    if command -v git >/dev/null 2>&1; then _bs_log "git: present"; else _bs_log "git: missing"; fi
    if _bs_have_cc; then _bs_log "cc: present"; else _bs_log "cc: missing"; fi
    exit 0
fi

# --- the harness core --------------------------------------------------------
#
# The one piece of bootstrap left in the shell tier, and the reason it cannot
# be in the binary: a script cannot exec the program that tells it where the
# program is. install.sh and wallpaper.sh delegate here rather than repeat it,
# so this block exists exactly once.
#
# Everything ui.sh used to set up around it -- the exported palette, $OSR_LOG,
# the step counters -- is the core's own startup now (osr.c's startup_env), so
# what is left is a path and a build.
OSR_ROOT=$OSR_SELF_DIR
OSR_LIB="$OSR_ROOT/lib"
# The dotfiles repo root is the parent of os-rice/ -- configs live there.
OSR_DOTFILES=$(cd -- "$OSR_ROOT/.." && pwd)
case ${OSR_C_MODULE_BACKEND:-static} in
    static)  OSR_C_MODULE_BACKEND=static; OSR_BIN="$OSR_ROOT/build/osr"; OSR_BUILD_TARGET=static ;;
    runtime) OSR_C_MODULE_BACKEND=runtime; OSR_BIN="$OSR_ROOT/build/osr-runtime"; OSR_BUILD_TARGET=runtime ;;
    *)
        printf '[ERROR] osr: OSR_C_MODULE_BACKEND must be static or runtime\n' >&2
        exit 2
        ;;
esac
export OSR_ROOT OSR_LIB OSR_DOTFILES OSR_BIN OSR_C_MODULE_BACKEND

# EVERY run, not just when build/osr is missing: nob tracks its own inputs and
# is a no-op when nothing changed, but skipping it means a `git pull` never
# reaches the binary -- the checkout says one thing and the box keeps doing
# another until someone remembers to run nob by hand.
#
# A build that fails with a usable binary already there is a warning, not a
# stop: a checkout someone else owns (or a box whose compiler just broke) must
# still be able to run the osr it already has.
# ...but only where the build inputs actually are: the test sandboxes assemble a
# root out of symlinks with no nob.c in it (see osr_detached above) and still
# expect the binary they linked in to run.
if [ -f "$OSR_ROOT/nob.c" ] && [ ! -x "$OSR_ROOT/build/nob" ]; then
    # nob.c is the build system (its header comment has the one-time bootstrap
    # line); osr.ps1 does the same thing on Windows. Building here is what
    # makes a fresh checkout work before anyone has built anything.
    mkdir -p "$OSR_ROOT/build" 2>/dev/null || :
    # shellcheck disable=SC2086  # $CC is a command line ("zig cc"), not one word
    ${CC:-cc} -o "$OSR_ROOT/build/nob" "$OSR_ROOT/nob.c" || {
        printf '[ERROR] osr: cannot bootstrap nob with %s\n' "${CC:-cc}" >&2
        [ -x "$OSR_BIN" ] || exit 1
    }
fi
if [ -f "$OSR_ROOT/nob.c" ] && [ -x "$OSR_ROOT/build/nob" ]; then
    # Quiet on the way through: nob says "everything up to date" on every no-op
    # run, and this now runs before every command, `osr theme` included.
    ( cd -- "$OSR_ROOT" && ./build/nob "$OSR_BUILD_TARGET" ) >/dev/null 2>&1 || {
        printf '[ERROR] osr: nob could not build %s\n' "$OSR_BIN" >&2
        ( cd -- "$OSR_ROOT" && ./build/nob "$OSR_BUILD_TARGET" ) >&2
        [ -x "$OSR_BIN" ] || exit 1
        printf '[WARN]  osr: running the binary already in build/ instead\n' >&2
    }
fi

_cmd=${1:-}
[ $# -gt 0 ] && shift

case "$_cmd" in
    install) exec "$OSR_BIN" install run "$@" ;;
    switch)  OSR_MODE=switch; export OSR_MODE; exec "$OSR_BIN" install run "$@" ;;
    module)  exec "$OSR_BIN" install run --module "$@" ;;
    theme)
        # `osr theme` with no name is a question, not a command.
        case "${1:-}" in
            ""|--*)
                _cur=$("$OSR_BIN" state get theme)
                printf '%s\n' "${_cur:-(none applied)}"
                exit 0
                ;;
        esac
        _theme=$1; shift
        exec "$OSR_BIN" install run --theme-only --theme "$_theme" "$@"
        ;;
    wallpaper) exec "$OSR_BIN" wallpaper "$@" ;;
    benchmark)
        # Dependency installs happen through the installer rather than inside
        # the benchmark: pulling packages is the module machinery's job, and
        # `osr module benchmark` is how you ask for it. The binary decides WHAT
        # is required -- it exits 3 when the workload is missing -- and this arm
        # gets it, then runs the benchmark again.
        _forced=0
        for _a in "$@"; do
            if [ "$_a" = "--install-deps" ]; then _forced=1; break; fi
        done
        # Written as an `if`, not `[ ... ] && cmd`: under `set -e` a failing
        # AND-OR list is itself a failing command, so the short form would exit
        # the script whenever --install-deps was absent.
        if [ "$_forced" = 1 ]; then
            "$OSR_BIN" install run --module benchmark
        fi

        _rc=0
        "$OSR_BIN" benchmark "$@" || _rc=$?
        # Exactly one retry: if the install did not actually supply the tool,
        # a second failure must surface rather than loop.
        if [ "$_rc" = 3 ] && [ "$_forced" = 0 ]; then
            "$OSR_BIN" install run --module benchmark
            _rc=0
            "$OSR_BIN" benchmark "$@" || _rc=$?
        fi
        # Still missing after an install that reported success means the package
        # exists under another name here, or installed something that is not on
        # PATH. Say that, rather than leaving two identical info lines as the
        # only explanation.
        if [ "$_rc" = 3 ]; then
            # `$OSR_BIN log error` rather than log.sh's error(): that one is not
            # sourced here, and it exits 1, which would throw away the exit
            # status that says specifically "the tool is missing".
            "$OSR_BIN" log error "benchmark workload still missing after running modules/benchmark.sh - check that stress-ng is packaged on this distro" || :
        fi
        exit $_rc
        ;;
    undervolt)
        "$OSR_BIN" undervolt "$@"
        ;;
    list)    exec "$OSR_BIN" install run --list ;;
    themes)  exec "$OSR_BIN" install run --list-themes ;;
    modules) exec "$OSR_BIN" install run --list-modules ;;
    test)
        "$OSR_BIN" test-run "$OSR_SELF_DIR/test"
        ;;
    -h|--help|"")
        sed -n '2,54p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "osr: unknown command '$_cmd' (try: install, switch, theme, wallpaper, module, benchmark, undervolt, list, themes, modules, test)" >&2
        exit 1
        ;;
esac

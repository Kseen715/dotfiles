.cache/
alias/

# C core build artifacts. nob.c writes every one of them under build/ --
# the programs, the test binaries, the objects and nob itself -- so this
# single line covers the lot on both a Windows and a Linux/CI host.
build/

# Stragglers from before that rule: a checkout built by an older nob still
# has binaries sitting next to the sources.
*.exe
*.exe.old
*.o
nob
install
wallpaper
test/unit_c/*_test
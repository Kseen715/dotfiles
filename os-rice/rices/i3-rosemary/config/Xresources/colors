
! ─── rosemuted palette (rice-owned, appended to the dotfiles Xresources base
! by modules/theming.sh; regenerated on rice switch, §6) ─────────────────────
!
! Base16-shaped so anything expecting base00..base0F resolves, and the ANSI 16
! below are the same colors mapped the way terminals actually use them (bright
! = a lightened variant, not a repeat of the normal color).

#define base00 #1c1f20
#define base01 #24282a
#define base02 #34393b
#define base03 #4e5456
#define base04 #8d8386
#define base05 #e8dfe1
#define base06 #b3a8ab
#define base07 #ffffff
#define base08 #e2655e
#define base09 #d3877a
#define base0A #d9b48f
#define base0B #9fb08a
#define base0C #8fb3b0
#define base0D #8f95bd
#define base0E #d98cae
#define base0F #f15495

*foreground:   base05
*background:   base00
*cursorColor:  base0E

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base05

*color8:       #4e5456
*color9:       #ef7d76
*color10:      #b6c6a1
*color11:      #eccba7
*color12:      #a7adcf
*color13:      #eda6c4
*color14:      #a8c9c6
*color15:      #ffffff

! i3lock-color / xsecurelock read these when invoked without explicit flags.
*i3lock.ring:  base0E
*i3lock.inside: base00

# Installed as ~/.local/share/icons/default/index.theme — rice-owned (§6).
# This is the X11 cursor-theme selector every toolkit-independent client reads
# (i3-sugg §4.4). XCURSOR_THEME in the xprofile layer covers the rest; the root
# window still needs `xsetroot -cursor_name left_ptr` if it shows the X cross.
#
# Vanilla-DMZ ships in xcursor-vanilla-dmz — Bibata and Capitaine are not
# packaged on Void, so a rose cursor means dropping a release tarball into
# ~/.local/share/icons/ and changing the two names below plus XCURSOR_THEME.

[Icon Theme]
Name=Default
Comment=Default cursor theme (os-rice, void-i3-rosemuted)
Inherits=Vanilla-DMZ

// config.jsonc — rice-owned fastfetch layout + colors (void-i3-rosemuted).
// Swapped on rice switch (§6).
//
// Colors are given as raw SGR sequences so they are the rice's actual hex
// values rather than one of the 16 terminal slots — fastfetch is often piped
// into a screenshot, and "whatever the terminal happens to be" is not a theme.
//   38;2;R;G;B = truecolor foreground
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": { "top": 1, "right": 3 },
    // accent #d98cae, muted rose #a86a84
    "color": { "1": "38;2;217;140;174", "2": "38;2;168;106;132" }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;217;140;174", "title": "38;2;241;84;149" },
    "percent": { "type": 9 },
    "constants": ["[38;2;77;84;86m"]
  },

  "modules": [
    { "type": "title", "color": { "user": "38;2;217;140;174", "host": "38;2;143;179;176" } },
    { "type": "separator", "string": "─" },

    { "type": "os",         "key": "  distro" },
    { "type": "kernel",     "key": "  kernel" },
    { "type": "packages",   "key": "  pkgs  " },
    { "type": "uptime",     "key": "  uptime" },
    { "type": "shell",      "key": "  shell " },
    { "type": "terminal",   "key": "  term  " },
    { "type": "wm",         "key": "  wm    " },
    { "type": "theme",      "key": "  theme " },
    { "type": "icons",      "key": "  icons " },
    { "type": "font",       "key": "  font  " },

    "break",

    { "type": "cpu",        "key": "  cpu   " },
    { "type": "gpu",        "key": "  gpu   " },
    { "type": "memory",     "key": "  ram   " },
    { "type": "swap",       "key": "  swap  " },
    { "type": "disk",       "key": "  disk  " },
    { "type": "battery",    "key": "  bat   " },
    { "type": "sound",      "key": "  audio " },
    { "type": "display",    "key": "  screen" },

    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}

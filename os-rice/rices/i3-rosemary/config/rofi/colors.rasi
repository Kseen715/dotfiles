/* colors.rasi — rice-owned rofi palette (void-i3-rosemuted). Swapped on rice
 * switch (§6); launcher.rasi and powermenu.rasi @import this and define no
 * colors of their own.
 *
 * The accent is the muted rose this rice is named for; @urgent keeps the hotter
 * pink from the reference dotfiles for things that must actually interrupt you.
 */

* {
    bg:          #1c1f20f2;
    bg-alt:      #24282aff;
    fg:          #e8dfe1ff;
    fg-muted:    #8d8386ff;
    accent:      #d98caeff;
    accent-dim:  #a86a84ff;
    urgent:      #f15495ff;
    transparent: #00000000;
}

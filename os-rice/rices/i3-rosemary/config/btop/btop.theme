# rosemuted btop theme — rice-owned theme layer (90-*, swapped on rice switch,
# §6). Same 16 colors as this rice's ghostty/Xresources palettes.

theme[main_bg]="#1c1f20"
theme[main_fg]="#e8dfe1"
theme[title]="#ffffff"
theme[hi_fg]="#d98cae"
theme[selected_bg]="#34393b"
theme[selected_fg]="#e8dfe1"
theme[inactive_fg]="#4e5456"
theme[graph_text]="#b3a8ab"
theme[meter_bg]="#24282a"
theme[proc_misc]="#8fb3b0"

# Box outlines
theme[cpu_box]="#d98cae"
theme[mem_box]="#9fb08a"
theme[net_box]="#8f95bd"
theme[proc_box]="#8fb3b0"
theme[div_line]="#34393b"

# Temperature graph
theme[temp_start]="#9fb08a"
theme[temp_mid]="#d9b48f"
theme[temp_end]="#e2655e"

# CPU graph
theme[cpu_start]="#8fb3b0"
theme[cpu_mid]="#d98cae"
theme[cpu_end]="#f15495"

# Mem/disk meters
theme[free_start]="#9fb08a"
theme[free_mid]=""
theme[free_end]="#8fb3b0"
theme[cached_start]="#8f95bd"
theme[cached_mid]=""
theme[cached_end]="#a7adcf"
theme[available_start]="#d9b48f"
theme[available_mid]=""
theme[available_end]="#d3877a"
theme[used_start]="#d98cae"
theme[used_mid]=""
theme[used_end]="#e2655e"

# Net graphs
theme[download_start]="#8fb3b0"
theme[download_mid]=""
theme[download_end]="#8f95bd"
theme[upload_start]="#d98cae"
theme[upload_mid]=""
theme[upload_end]="#f15495"

# Process list gradient
theme[process_start]="#9fb08a"
theme[process_mid]="#d9b48f"
theme[process_end]="#e2655e"

# rosemuted.micro — rice-owned micro colorscheme (void-i3-rosemuted), installed
# to ~/.config/micro/colorschemes/ and selected by the dotfiles-owned
# settings.json. Swapped on rice switch (§6).
#
# micro's format: <group> <fg>,<bg> with optional bold/italic/underline.

color-link default "#e8dfe1,#1c1f20"
color-link comment "#8d8386,#1c1f20"
color-link identifier "#8fb3b0,#1c1f20"
color-link identifier.class "#d98cae,#1c1f20"
color-link constant "#d3877a,#1c1f20"
color-link constant.number "#d3877a,#1c1f20"
color-link constant.string "#9fb08a,#1c1f20"
color-link constant.string.char "#9fb08a,#1c1f20"
color-link statement "#d98cae,#1c1f20"
color-link symbol "#e8dfe1,#1c1f20"
color-link symbol.brackets "#b3a8ab,#1c1f20"
color-link symbol.tag "#8f95bd,#1c1f20"
color-link preproc "#d9b48f,#1c1f20"
color-link type "#d9b48f,#1c1f20"
color-link type.keyword "#d98cae,#1c1f20"
color-link special "#f15495,#1c1f20"
color-link ignore "#4e5456,#1c1f20"
color-link error "#1c1f20,#e2655e"
color-link todo "#1c1f20,#d9b48f"

color-link statusline "#1c1f20,#d98cae"
color-link tabbar "#b3a8ab,#24282a"
color-link indent-char "#34393b,#1c1f20"
color-link line-number "#4e5456,#1c1f20"
color-link current-line-number "#d98cae,#1c1f20"
color-link cursor-line "#24282a"
color-link color-column "#24282a"
color-link selection "#e8dfe1,#34393b"
color-link gutter-error "#e2655e,#1c1f20"
color-link gutter-warning "#d9b48f,#1c1f20"
color-link diff-added "#9fb08a,#1c1f20"
color-link diff-modified "#d9b48f,#1c1f20"
color-link diff-deleted "#e2655e,#1c1f20"
color-link match-brace "#1c1f20,#d98cae"
color-link hlsearch "#1c1f20,#d9b48f"

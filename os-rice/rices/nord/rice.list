# nord — same modules as gruvbox, different rice-owned theme. Proves the switch
# asymmetry: packages accrete, only 90-* config is replaced (§6).

# --- themes (§6a) -------------------------------------------------------------
# `theme:` is the theme installed with this rice; `themes:` is the set the rice
# ships and `osr theme` / Proteus offer for live switching. A theme is a
# standalone directory under themes/ - any of them applies onto any rice, this
# line only says which ones this rice was designed and tested against.
theme: nord
themes: catppuccin nord gruvbox xin


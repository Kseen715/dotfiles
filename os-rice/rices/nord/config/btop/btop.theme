# nord btop theme — rice-owned theme layer (90-*, swapped on rice switch, §6).
# Same 16 colors as this rice's ghostty palette.

# Main background, empty for terminal default; ignored while btop.conf keeps
# theme_background = False (transparent background).
theme[main_bg]="#2e3440"
theme[main_fg]="#d8dee9"
theme[title]="#eceff4"
theme[hi_fg]="#bf616a"
theme[selected_bg]="#434c5e"
theme[selected_fg]="#d8dee9"
theme[inactive_fg]="#4c566a"
theme[graph_text]="#e5e9f0"
theme[meter_bg]="#3b4252"
theme[proc_misc]="#8fbcbb"

# Box outlines
theme[cpu_box]="#8fbcbb"
theme[mem_box]="#a3be8c"
theme[net_box]="#b48ead"
theme[proc_box]="#81a1c1"
theme[div_line]="#4c566a"

# Temperature graph
theme[temp_start]="#a3be8c"
theme[temp_mid]="#ebcb8b"
theme[temp_end]="#bf616a"

# CPU graph
theme[cpu_start]="#88c0d0"
theme[cpu_mid]="#ebcb8b"
theme[cpu_end]="#bf616a"

# Mem/disk meters
theme[free_start]="#a3be8c"
theme[free_mid]=""
theme[free_end]="#a3be8c"
theme[cached_start]="#81a1c1"
theme[cached_mid]=""
theme[cached_end]="#81a1c1"
theme[available_start]="#ebcb8b"
theme[available_mid]=""
theme[available_end]="#ebcb8b"
theme[used_start]="#bf616a"
theme[used_mid]=""
theme[used_end]="#bf616a"

# Net graphs
theme[download_start]="#8fbcbb"
theme[download_mid]=""
theme[download_end]="#88c0d0"
theme[upload_start]="#b48ead"
theme[upload_mid]=""
theme[upload_end]="#b48ead"

# Process list gradient
theme[process_start]="#a3be8c"
theme[process_mid]="#ebcb8b"
theme[process_end]="#bf616a"

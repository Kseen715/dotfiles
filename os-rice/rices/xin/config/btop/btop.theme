# xin btop theme — rice-owned theme layer (90-*, swapped on rice switch, §6).
# Same 16 colors as this rice's foot/ghostty palettes.

# Main background, empty for terminal default; ignored while btop.conf keeps
# theme_background = False (transparent background).
theme[main_bg]="#181818"
theme[main_fg]="#ffffff"
theme[title]="#ededed"
theme[hi_fg]="#f0424b"
theme[selected_bg]="#303030"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#525252"
theme[graph_text]="#bbbbbb"
theme[meter_bg]="#1e1e1e"
theme[proc_misc]="#90bbba"

# Box outlines
theme[cpu_box]="#90bbba"
theme[mem_box]="#55dc28"
theme[net_box]="#d45eb7"
theme[proc_box]="#3292dc"
theme[div_line]="#525252"

# Temperature graph
theme[temp_start]="#338716"
theme[temp_mid]="#d4c310"
theme[temp_end]="#be0f17"

# CPU graph
theme[cpu_start]="#578f8d"
theme[cpu_mid]="#f3e659"
theme[cpu_end]="#f0424b"

# Mem/disk meters
theme[free_start]="#55dc28"
theme[free_mid]=""
theme[free_end]="#338716"
theme[cached_start]="#3292dc"
theme[cached_mid]=""
theme[cached_end]="#185b8f"
theme[available_start]="#f3e659"
theme[available_mid]=""
theme[available_end]="#d4c310"
theme[used_start]="#f0424b"
theme[used_mid]=""
theme[used_end]="#be0f17"

# Net graphs
theme[download_start]="#90bbba"
theme[download_mid]=""
theme[download_end]="#578f8d"
theme[upload_start]="#d45eb7"
theme[upload_mid]=""
theme[upload_end]="#a12b84"

# Process list gradient
theme[process_start]="#55dc28"
theme[process_mid]="#f3e659"
theme[process_end]="#f0424b"

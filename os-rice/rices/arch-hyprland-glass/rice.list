# arch-hyprland-glass — the Hyprland "glass" desktop, salvaged from the legacy
# linux-arch-x86_64-hyprland-glass bundle into the DRY os-rice framework.
# One line per module; manifest order IS the dependency graph (§4): paru (the
# AUR helper, built from source) comes before any aur: package, toolchains
# before their consumers. Each module installs its package(s) via pkg_install
# and copies its own rice-owned config from this rice's config/ dir (§5/§6).
#
# Arch/x86_64/systemd only — declared up front so a mismatched host fails clean
# before any mutation (§10). gpu:present gates the Hyprland DE on a real GPU.
require: arch:x86_64
require: init:systemd
require: gpu:present

# --- AUR bootstrap ------------------------------------------------------------
# paru first: it is source:provide_paru, and every aur: row below dispatches
# through it (manifest order is the dependency graph, §4).
paru

# --- base ---------------------------------------------------------------------
git-base
openssh
zip
pacman-multilib
networkmanager

# --- hardware (real-GPU / kernel dependent; validated on hardware, not CI) ----
dkms
cpu-microcodes
gpu-drivers
vmware-init

# --- shell + CLI --------------------------------------------------------------
# starship before zsh: zsh's 90-theme.zsh wires the prompt in (manifest order is
# the dependency graph, §4). starship owns its Nerd Font + rice starship.toml.
starship
zsh
micro
htop
btop
fastfetch
yazi

# --- Wayland + Hyprland core --------------------------------------------------
wayland
hyprland
sddm
hyprpaper
hyprpicker
hyprlock
hyprcursor
hypridle

# --- bar / launcher / notifications / clipboard -------------------------------
waybar
wleave
mako
gtklock
wofi
cliphist

# --- audio --------------------------------------------------------------------
# pipewire first: it swaps PulseAudio/JACK out, and the patchbay/EQ below are
# PipeWire clients (manifest order is the dependency graph, §4). Its mirror,
# `pulseaudio`, is the available alternative — never list both.
pipewire
qpwgraph
easyeffects

# --- display / misc DE --------------------------------------------------------
luminance
nwg-displays
printer
foot
nautilus
kate

# --- applications -------------------------------------------------------------
celluloid
firefox
vscode-insiders
discord
telegram
obs-studio
qbittorrent
amnezia-vpn
steam

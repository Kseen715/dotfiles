{
    "_comment": [
        "KSyntaxHighlighting theme template (§6b) -> ~/.local/share/",
        "org.kde.syntax-highlighting/themes/osr.theme. The KDE color scheme",
        "(kde/color-scheme.colors.tmpl) paints Kate's chrome; this file paints the",
        "text area, which is a separate theme system Kate selects by the",
        "metadata name below ([KTextEditor Renderer] Color Theme in katerc)."
    ],
    "metadata": {
        "name": "os-rice",
        "revision": 1,
        "license": "MIT",
        "copyright": ["os-rice, generated from theme {{THEME}}"]
    },
    "editor-colors": {
        "BackgroundColor": "{{background}}",
        "CodeFolding": "{{selection_background}}",
        "BracketMatching": "{{surface_mid}}",
        "CurrentLine": "{{background_sunken}}",
        "CurrentLineNumber": "{{foreground}}",
        "IconBorder": "{{panel_background}}",
        "IndentationLine": "{{border}}",
        "LineNumbers": "{{text_muted}}",
        "MarkBookmark": "{{accent_blue}}",
        "MarkBreakpointActive": "{{error}}",
        "MarkBreakpointDisabled": "{{accent_magenta}}",
        "MarkBreakpointReached": "{{warning}}",
        "MarkError": "{{error}}",
        "MarkExecution": "{{text_muted}}",
        "MarkWarning": "{{warning}}",
        "ModifiedLines": "{{warning}}",
        "ReplaceHighlight": "{{accent_green}}",
        "SavedLines": "{{success}}",
        "SearchHighlight": "{{accent_yellow}}",
        "Separator": "{{border}}",
        "SpellChecking": "{{error}}",
        "TabMarker": "{{border}}",
        "TemplateBackground": "{{panel_background}}",
        "TemplateFocusedPlaceholder": "{{accent_green}}",
        "TemplatePlaceholder": "{{surface_mid}}",
        "TemplateReadOnlyPlaceholder": "{{error}}",
        "TextSelection": "{{selection_background}}",
        "WordWrapMarker": "{{border}}"
    },
    "text-styles": {
        "Normal":        { "text-color": "{{foreground}}", "selected-text-color": "{{selection_foreground}}" },
        "Keyword":       { "text-color": "{{accent_magenta}}", "selected-text-color": "{{accent_magenta}}", "bold": true },
        "Function":      { "text-color": "{{accent_blue}}", "selected-text-color": "{{accent_blue}}" },
        "Variable":      { "text-color": "{{foreground}}", "selected-text-color": "{{selection_foreground}}" },
        "ControlFlow":   { "text-color": "{{accent_magenta}}", "selected-text-color": "{{accent_magenta}}", "bold": true },
        "Operator":      { "text-color": "{{accent_cyan}}", "selected-text-color": "{{accent_cyan}}" },
        "BuiltIn":       { "text-color": "{{accent_cyan}}", "selected-text-color": "{{accent_cyan}}" },
        "Extension":     { "text-color": "{{accent_blue}}", "selected-text-color": "{{accent_blue}}", "bold": true },
        "Preprocessor":  { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "Attribute":     { "text-color": "{{accent_yellow}}", "selected-text-color": "{{accent_yellow}}" },
        "Char":          { "text-color": "{{accent_cyan}}", "selected-text-color": "{{accent_cyan}}" },
        "SpecialChar":   { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "String":        { "text-color": "{{accent_green}}", "selected-text-color": "{{accent_green}}" },
        "VerbatimString":{ "text-color": "{{accent_green}}", "selected-text-color": "{{accent_green}}" },
        "SpecialString": { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "Import":        { "text-color": "{{accent_magenta}}", "selected-text-color": "{{accent_magenta}}" },
        "DataType":      { "text-color": "{{accent_yellow}}", "selected-text-color": "{{accent_yellow}}" },
        "DecVal":        { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "BaseN":         { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "Float":         { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "Constant":      { "text-color": "{{accent_orange}}", "selected-text-color": "{{accent_orange}}" },
        "Comment":       { "text-color": "{{text_muted}}", "selected-text-color": "{{text_muted}}", "italic": true },
        "Documentation": { "text-color": "{{text_faint}}", "selected-text-color": "{{text_faint}}", "italic": true },
        "Annotation":    { "text-color": "{{text_metadata}}", "selected-text-color": "{{text_metadata}}" },
        "CommentVar":    { "text-color": "{{text_metadata}}", "selected-text-color": "{{text_metadata}}" },
        "RegionMarker":  { "text-color": "{{accent_blue}}", "selected-text-color": "{{accent_blue}}", "background-color": "{{panel_background}}" },
        "Information":   { "text-color": "{{accent_blue}}", "selected-text-color": "{{accent_blue}}" },
        "Warning":       { "text-color": "{{warning}}", "selected-text-color": "{{warning}}" },
        "Alert":         { "text-color": "{{urgent}}", "selected-text-color": "{{urgent}}", "background-color": "{{panel_background}}", "bold": true },
        "Error":         { "text-color": "{{error}}", "selected-text-color": "{{error}}", "underline": true },
        "Others":        { "text-color": "{{accent_green}}", "selected-text-color": "{{accent_green}}" }
    },
    "custom-styles": {}
}

# i3 config — dotfiles-owned base layer (os-rice §5). Overwritten on update.
#
# Colors, gaps, fonts and the wallpaper live in ~/.config/i3/config.d/90-theme.conf
# (rice-owned, swapped on rice switch). Your own overrides go in
# ~/.config/i3/config.d/99-local.conf, which os-rice creates once and never touches.
# The include at the bottom pulls both in, so the last word is always yours.

set $mod Mod4
set $alt Mod1
set $term osr-term
set $filemanager thunar
set $browser firefox

# Font is set again by the theme layer; this is the fallback if none is installed.
font pango:monospace 10

floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no
workspace_auto_back_and_forth yes

# ─────────────────────────────────────────────────────────────────────────────
#  Session glue — the difference between "i3 starts" and "apps behave"
# ─────────────────────────────────────────────────────────────────────────────

# Hand the session env to D-Bus activated services (portals, keyring, tray apps).
# Without this a portal file dialog opens on no display and silently does nothing.
exec --no-startup-id dbus-update-activation-environment --all DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP

# Polkit agent: every GUI action that needs root fails silently without it.
exec --no-startup-id sh -c 'for a in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/x86_64-linux-gnu/polkit-gnome/polkit-gnome-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'

# Secret Service (VS Code, Chrome, git credentials) when no display manager
# started it — harmless if one already did.
exec --no-startup-id gnome-keyring-daemon --start --components=secrets,ssh

# XDG autostart entries (nm-applet, blueman, etc. install .desktop files that
# i3 would otherwise never run).
exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xrdb -merge ~/.Xresources
exec_always --no-startup-id xsettingsd
exec_always --no-startup-id autorandr --change
exec_always --no-startup-id ~/.config/picom/launch.sh
# dwindle-style splits: no more manually toggling split h/v before every window.
exec_always --no-startup-id autotiling
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id dunst
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id udiskie --tray
exec --no-startup-id copyq
exec --no-startup-id numlockx on
# Input method: -d daemonizes; without the env vars in xprofile.d/10-session.sh
# it starts but no toolkit talks to it.
exec --no-startup-id fcitx5 -d
# Touchpad swipes -> workspace switching (config in ~/.config/libinput-gestures.conf).
exec --no-startup-id libinput-gestures-setup start
# Per-window keyboard layout memory.
exec --no-startup-id kbdd
exec --no-startup-id unclutter --timeout 3
exec --no-startup-id thunar --daemon
exec --no-startup-id redshift

# PipeWire on inits with no user units (runit, OpenRC). On systemd these are
# socket-activated and the second start exits immediately, so it is harmless.
exec --no-startup-id pipewire
exec --no-startup-id pipewire-pulse
exec --no-startup-id wireplumber

# Idle + lock. xss-lock also carries the suspend inhibitor, which is what makes
# the screen actually locked when the lid opens again.
#
# No IDLE timer. xss-lock stays because it is not a timer: it is what makes the
# lock happen BEFORE suspend rather than after resume, so the screen is never
# briefly readable on wake, and it is what $mod+Escape and `loginctl lock-session`
# route through. What is deliberately absent is the automatic
# lock-after-N-minutes daemon (xidlehook / xautolock, either of which
# modules/i3lock.sh may have installed) - locking is a thing you ask for here.
#
# To put the timer back, uncomment ONE of these in ~/.config/i3/config.d/99-local.conf
# (which this file never overwrites):
#   exec --no-startup-id xidlehook --not-when-audio --not-when-fullscreen \
#        --timer 600 "betterlockscreen -l dimblur" ""
#   exec --no-startup-id xautolock -time 10 -locker "betterlockscreen -l dimblur" -detectsleep
# Removing the timer daemon is only half of it, and `xset s off` is only two
# thirds. xss-lock fires on the X screensaver AND on DPMS: with the screensaver
# off but DPMS still counting down from 600s, the panel blanked after ten
# minutes and xss-lock locked the session right along with it. Measured - `xset
# q` reported `timeout: 0` next to `Standby/Suspend/Off: 600`, and the screen
# kept locking itself with no timer daemon running at all.
#
# So both go. The cost is honest and worth stating: the panel no longer powers
# down on idle, which on a laptop is battery. Blanking without locking is not
# expressible here - xss-lock cannot tell the two events apart - so it would
# take a separate idle daemon whose only action is `xset dpms force off`.
exec_always --no-startup-id xset s off -dpms

exec --no-startup-id xss-lock --transfer-sleep-lock -- betterlockscreen -l dimblur

# ─────────────────────────────────────────────────────────────────────────────
#  Keys
# ─────────────────────────────────────────────────────────────────────────────

bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Tab exec --no-startup-id rofi -show window
bindsym $mod+r exec --no-startup-id rofi -show run
bindsym $mod+period exec --no-startup-id rofimoji
bindsym $mod+e exec $filemanager
bindsym $mod+b exec $browser
bindsym $mod+v exec --no-startup-id copyq toggle
bindsym $mod+c exec --no-startup-id xcolor -s
# Lock. $mod+l is the one everybody reaches for; $mod+Escape stays as the
# alias that was here first, so existing muscle memory keeps working.
bindsym $mod+l exec --no-startup-id betterlockscreen -l dimblur
bindsym $mod+Escape exec --no-startup-id betterlockscreen -l dimblur
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/rofi-powermenu.sh
# Proteus: the theme/wallpaper picker (os-rice §6a). Same overlay behaviour
# as rofi - it is override-redirect, so i3 never tiles it.
bindsym $mod+Shift+d exec --no-startup-id proteus
bindsym $mod+Shift+w exec --no-startup-id osr wallpaper --next

bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload

# Screenshots: region straight to clipboard, full screen to file, GUI for the rest.
bindsym Print            exec --no-startup-id maim -su | xclip -selection clipboard -t image/png
bindsym Shift+Print      exec --no-startup-id sh -c 'mkdir -p ~/Pictures/Screenshots && maim ~/Pictures/Screenshots/$(date +%F-%H%M%S).png'
bindsym $mod+Print       exec --no-startup-id flameshot gui

# Media / volume / backlight. These go through osd.sh rather than calling the
# mixer directly, for two reasons: it draws the progress popup every other
# desktop draws (i3 has no OSD of its own), and it picks the mixer that is
# actually installed — pamixer is absent on Debian 11 and Ubuntu 22.04, where
# pactl takes over and the keys keep working.
bindsym XF86AudioRaiseVolume  exec --no-startup-id ~/.config/i3/scripts/osd.sh volume-up
bindsym XF86AudioLowerVolume  exec --no-startup-id ~/.config/i3/scripts/osd.sh volume-down
bindsym XF86AudioMute         exec --no-startup-id ~/.config/i3/scripts/osd.sh mute
bindsym XF86AudioMicMute      exec --no-startup-id ~/.config/i3/scripts/osd.sh mic-mute
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id ~/.config/i3/scripts/osd.sh light-up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/scripts/osd.sh light-down

# Focus / move. Arrows only: the vim hjkl cluster is deliberately NOT bound
# here, because $mod+l is the lock (see Keys below) and a cluster with one key
# missing is worse than no cluster - you reach for $mod+l out of habit and lock
# the screen instead of moving focus. The resize mode below still takes hjkl,
# which is unambiguous because it is modal.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout. Through layout.sh rather than `layout tabbed` directly: autotiling
# wraps the focused window in a single-child split container on every focus
# event, and a bare layout command lands on THAT wrapper - it looks like the
# binding did nothing, and then new windows open as tabs inside the invisible
# container. layout.sh climbs to the container you actually meant. See its
# header for the tree.
bindsym $mod+s exec --no-startup-id ~/.config/i3/scripts/layout.sh toggle-split
bindsym $mod+w exec --no-startup-id ~/.config/i3/scripts/layout.sh tabbed
bindsym $mod+Shift+s exec --no-startup-id ~/.config/i3/scripts/layout.sh stacking
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Control+r mode "resize"

# ─────────────────────────────────────────────────────────────────────────────
#  Workspaces
# ─────────────────────────────────────────────────────────────────────────────

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ─────────────────────────────────────────────────────────────────────────────
#  Window rules — the ones everyone eventually needs
# ─────────────────────────────────────────────────────────────────────────────

for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="Pavucontrol|Blueman-manager|Nm-connection-editor|Arandr|Lxappearance|Gpick|Xcolor"] floating enable
for_window [class="(?i)copyq"] floating enable
for_window [class="Thunar" window_role="dialog"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [title="File Operation Progress"] floating enable
for_window [class="steam" title="Friends List"] floating enable

# Java/Swing apps render a grey box under i3 without _JAVA_AWT_WM_NONREPARENTING
# (exported by ~/.config/xprofile.d/10-session.sh) — this is the second half.
for_window [class="jetbrains-.*" title="win0"] floating enable, border none

# ─────────────────────────────────────────────────────────────────────────────
#  Layers: rice theme (90) then machine-local (99). Keep this last.
# ─────────────────────────────────────────────────────────────────────────────
include ~/.config/i3/config.d/*.conf

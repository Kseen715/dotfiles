/* gtk.css — theme-owned GTK3 accents, rendered per theme (§6b). Swapped on switch.
 *
 * Adwaita-dark supplies the neutral chrome; this file only re-tints the parts
 * that carry the accent colour, which is why no GTK theme has to be vendored.
 * @define-color overrides work on Adwaita because it reads these named colours.
 */

@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{background}};
@define-color accent_bg_color {{accent}};
@define-color accent_fg_color {{background}};
@define-color accent_color {{accent}};
@define-color theme_bg_color {{background}};
@define-color theme_base_color {{panel_background}};
@define-color theme_fg_color {{foreground}};
@define-color theme_text_color {{foreground}};
@define-color insensitive_fg_color {{text_faint}};
@define-color borders {{selection_background}};
@define-color warning_color {{warning}};
@define-color error_color {{error}};
@define-color success_color {{success}};
@define-color destructive_color {{error}};

/* Focus rings read as grey on Adwaita-dark; make them the accent. */
*:focus-visible {
    outline-color: alpha(@accent_color, 0.6);
}

/* Selection inside text views/entries, which does not follow the named colour
 * on every widget. */
selection {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}

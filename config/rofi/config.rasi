/* rofi/config.rasi — dotfiles-owned base layer (os-rice §5).
 * Behaviour and default theme selection only; every color lives in the
 * rice-owned colors.rasi that launcher.rasi and powermenu.rasi @import.
 */

configuration {
    /* Built-in modes only. `emoji` needs the rofi-emoji plugin, which is not
     * packaged for rofi 2.x -- and rofi refuses to start at all when a listed
     * mode is missing ("Mode emoji is not found"), so one absent plugin breaks
     * the launcher, not just the picker. The emoji picker is rofimoji, bound
     * to $mod+period: a separate binary driving rofi as its frontend, no
     * plugin ABI involved. */
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "window";
    sidebar-mode:        false;
    hide-scrollbar:      true;
    disable-history:     false;
    sort:                true;
    matching:            "fuzzy";
    /* Same launcher i3's $term resolves to, so a rofi-opened terminal
     * degrades the same way a $mod+Return one does. Passes -e through. */
    terminal:            "osr-term";
    kb-cancel:           "Escape,Super+d";
}

@theme "~/.config/rofi/launcher.rasi"

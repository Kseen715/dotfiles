; Qt color scheme — theme-owned, rendered per theme (§6b), installed as
; ~/.config/qt6ct/colors/rice.conf and selected by qt6ct.conf. Swapped on rice
; switch (§6). Same file shape for qt5ct.
;
; 20 roles per group, in Qt's fixed order:
;   WindowText Button Light Midlight Dark Mid Text BrightText ButtonText Base
;   Window Shadow Highlight HighlightedText Link LinkVisited AlternateBase
;   NoRole ToolTipBase ToolTipText
; Format is #aarrggbb.

[ColorScheme]
active_colors=#ff{{foreground_rgb}}, #ff{{panel_background_rgb}}, #ff{{text_muted_rgb}}, #ff{{selection_background_rgb}}, #ff{{background_sunken_rgb}}, #ff{{surface_mid_rgb}}, #ff{{foreground_rgb}}, {{ansi_bright_white}}ff, #ff{{foreground_rgb}}, #ff{{background_rgb}}, #ff{{background_rgb}}, #ff{{shadow_rgb}}, #ff{{accent_rgb}}, #ff{{background_rgb}}, #ff{{accent_blue_rgb}}, #ff{{accent_rgb}}, #ff{{panel_background_rgb}}, #ff{{background_rgb}}, #ff{{panel_background_rgb}}, #ff{{foreground_rgb}}
inactive_colors=#ff{{text_primary_rgb}}, #ff{{panel_background_rgb}}, #ff{{text_muted_rgb}}, #ff{{selection_background_rgb}}, #ff{{background_sunken_rgb}}, #ff{{surface_mid_rgb}}, #ff{{text_primary_rgb}}, {{ansi_bright_white}}ff, #ff{{text_primary_rgb}}, #ff{{background_rgb}}, #ff{{background_rgb}}, #ff{{shadow_rgb}}, #ff{{text_metadata_rgb}}, #ff{{background_rgb}}, #ff{{accent_blue_rgb}}, #ff{{accent_rgb}}, #ff{{panel_background_rgb}}, #ff{{background_rgb}}, #ff{{panel_background_rgb}}, #ff{{foreground_rgb}}
disabled_colors=#ff{{text_faint_rgb}}, #ff{{panel_background_rgb}}, #ff{{text_muted_rgb}}, #ff{{selection_background_rgb}}, #ff{{background_sunken_rgb}}, #ff{{surface_mid_rgb}}, #ff{{text_faint_rgb}}, #ff{{text_faint_rgb}}, #ff{{text_faint_rgb}}, #ff{{background_rgb}}, #ff{{background_rgb}}, #ff{{shadow_rgb}}, #ff{{selection_background_rgb}}, #ff{{text_faint_rgb}}, #ff{{text_muted_rgb}}, #ff{{text_muted_rgb}}, #ff{{panel_background_rgb}}, #ff{{background_rgb}}, #ff{{panel_background_rgb}}, #ff{{text_faint_rgb}}

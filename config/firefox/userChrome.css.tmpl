/* userChrome.css — theme-owned Firefox chrome colors, rendered per theme (§6b).
 * Swapped on theme switch (§6). Requires
 * toolkit.legacyUserProfileCustomizations.stylesheets=true, which the
 * dotfiles-owned user.js sets — the two are installed together by
 * modules/firefox.sh.
 *
 * Chrome only. Page content follows the site + prefers-color-scheme; forcing
 * colors there breaks half the web.
 */

:root {
    --rm-bg:      {{background}};
    --rm-bg-alt:  {{panel_background}};
    --rm-fg:      {{foreground}};
    --rm-muted:   {{text_faint}};
    --rm-accent:  {{accent}};
    --rm-border:  {{selection_background}};
}

/* Toolbars + tab strip */
#navigator-toolbox,
#nav-bar,
#PersonalToolbar,
#titlebar,
#TabsToolbar {
    background-color: var(--rm-bg) !important;
    color: var(--rm-fg) !important;
    border-color: var(--rm-border) !important;
}

/* The address bar */
#urlbar-background,
#searchbar {
    background-color: var(--rm-bg-alt) !important;
    border-color: var(--rm-border) !important;
}
#urlbar[focused="true"] > #urlbar-background {
    border-color: var(--rm-accent) !important;
    box-shadow: 0 0 0 1px var(--rm-accent) !important;
}

/* Tabs: the selected one is the only thing wearing the accent. */
.tabbrowser-tab .tab-background {
    background-color: transparent !important;
    border-radius: 8px !important;
}
.tabbrowser-tab[selected] .tab-background {
    background-color: var(--rm-bg-alt) !important;
    border-bottom: 2px solid var(--rm-accent) !important;
}
.tabbrowser-tab:not([selected]) .tab-label {
    color: var(--rm-muted) !important;
}
.tabbrowser-tab[selected] .tab-label {
    color: var(--rm-fg) !important;
}

/* Findbar + sidebar */
findbar,
#sidebar-box,
#sidebar-header {
    background-color: var(--rm-bg) !important;
    color: var(--rm-fg) !important;
}

/* Loading indicator */
#tabbrowser-tabs .tab-throbber {
    fill: var(--rm-accent) !important;
}

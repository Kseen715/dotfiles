;; colors.ini — theme-owned polybar palette, rendered per theme (§6b). Swapped on rice
;; switch (§6); config.ini and modules.ini reference these as ${color.*} and
;; carry no hex codes of their own.

[color]
background = #ee{{background_rgb}}
background-alt = {{panel_background}}
foreground = {{foreground}}
muted = {{text_faint}}
accent = {{accent}}
accent-dim = {{text_metadata}}
urgent = {{urgent}}
red = {{error}}
orange = {{accent_orange}}
yellow = {{warning}}
green = {{success}}
cyan = {{accent_cyan}}
blue = {{accent_blue}}

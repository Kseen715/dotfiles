# Konsole color scheme template (§6b) -> ~/.local/share/konsole/osr.colorscheme.
# The same 16 ANSI slots the ghostty/foot/wezterm templates render, in the
# decimal spelling Konsole wants.
[Background]
Color={{panel_background_dec}}

[BackgroundFaint]
Color={{panel_background_dec}}

[BackgroundIntense]
Color={{panel_background_dec}}

[Color0]
Color={{panel_background_dec}}

[Color0Faint]
Color={{panel_background_dec}}

[Color0Intense]
Color={{text_faint_dec}}

[Color1]
Color={{ansi_red_dec}}

[Color1Faint]
Color={{ansi_red_dec}}

[Color1Intense]
Color={{urgent_dec}}

[Color2]
Color={{ansi_green_dec}}

[Color2Faint]
Color={{ansi_green_dec}}

[Color2Intense]
Color={{accent_green_dec}}

[Color3]
Color={{warning_dec}}

[Color3Faint]
Color={{warning_dec}}

[Color3Intense]
Color={{accent_dec}}

[Color4]
Color={{ansi_blue_dec}}

[Color4Faint]
Color={{ansi_blue_dec}}

[Color4Intense]
Color={{accent_blue_dec}}

[Color5]
Color={{text_metadata_dec}}

[Color5Faint]
Color={{text_metadata_dec}}

[Color5Intense]
Color={{accent_magenta_dec}}

[Color6]
Color={{ansi_cyan_dec}}

[Color6Faint]
Color={{ansi_cyan_dec}}

[Color6Intense]
Color={{success_dec}}

[Color7]
Color={{text_primary_dec}}

[Color7Faint]
Color={{text_primary_dec}}

[Color7Intense]
Color={{foreground_dec}}

[Foreground]
Color={{foreground_dec}}

[ForegroundFaint]
Color={{foreground_dec}}

[ForegroundIntense]
Color={{foreground_dec}}

[General]
Blur=false
Description=Gruvbox
Opacity=1
Wallpaper=

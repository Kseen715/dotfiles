# ghostty/ghostty-theme — dotfiles DEFAULT Ghostty palette (§6 fallback). Used
# only when the installed rice ships no config/ghostty/ghostty-theme of its own.
# Same 16 colors as the default foot palette (foot/foot-colors.ini), so both
# terminals look identical on an unthemed host.
#
# Included from ghostty/config, which sets background-opacity — override it here
# (or in a rice theme) to make one theme more/less transparent than the base.

background = #181818
foreground = #ffffff
cursor-color = #ffffff
selection-background = #303030
selection-foreground = #ffffff

palette = 0=#1e1e1e
palette = 1=#be0f17
palette = 2=#338716
palette = 3=#d4c310
palette = 4=#185b8f
palette = 5=#a12b84
palette = 6=#578f8d
palette = 7=#bbbbbb
palette = 8=#525252
palette = 9=#f0424b
palette = 10=#55dc28
palette = 11=#f3e659

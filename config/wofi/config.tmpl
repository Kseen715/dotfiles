# themes/xin/config/wofi/config - the xin launcher.
#
# Absolute pixel size, not the glass theme's percentages: mutter implements no
# wlr_layer_shell, so on a GNOME session wofi prints "switching to normal window
# mode" and sizes itself as an ordinary toplevel. A percentage has nothing to be
# a percentage OF there, and wofi hands GTK a zero height for it
# ("gdk_wayland_window_configure: assertion 'height > 0' failed"). Fixed numbers
# render identically under Hyprland, so this costs the wlroots case nothing.
show=drun
term=alacritty
show_all=true
gtk_dark=true
location=center
allow_markup=true
# Icons off. Measured on resolute (176 .desktop entries, Papirus-Dark): wofi
# reaches idle in ~850ms with images and ~420ms without -- half the launcher's
# whole startup is GTK rasterising one SVG per entry through the glycin pixbuf
# loader, synchronously, before the first frame. wofi 1.5.1 has no icon cache
# and no lazy row rendering, so there is nothing to precache: the work is
# redone on every Super+R. Neither a raster icon theme (~170ms back) nor
# image_size=16 nor GLYCIN_SANDBOX_MECHANISM=not-sandboxed moved it. The
# remaining ~420ms is GTK init plus the .desktop scan, wofi's floor.
allow_images=false
line_wrap=word
width=600
height=420
hide_scroll=true
insensitive=true
prompt=search

# Entries whose .desktop declares Actions= (Alacritty's "New", Ghostty's
# windows) otherwise collapse behind a `>` expander. Not worth it here: wofi
# ships no default key to open one, its first Right lands on the expander title
# rather than the list, and the inner GtkListBox keeps a stale row selected
# after focus leaves. One flat list of primary actions instead.
no_actions=true

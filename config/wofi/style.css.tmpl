/* themes/xin/config/wofi/style.css - the xin palette on wofi.
 *
 * Opaque, unlike the glass theme's translucent twin: xin is `session: any` and
 * runs under GNOME/mutter as often as under Hyprland, and mutter does not blur
 * layer surfaces. A transparent panel there is not frosted glass, it is the
 * desktop showing through the entry text. */

@define-color bg      {{background}};
@define-color surface {{selection_background}};
@define-color fg      {{foreground}};
@define-color dim     {{text_muted}};
@define-color accent  {{accent}};

* {
  border: none;
  border-radius: 8px;
  /* GTK's focus ring is a dashed rectangle that hugs whatever widget owns
   * focus - on an expanded drun entry that is the expander row itself, not
   * #entry, so it drew a second box tight around the label. The only ring
   * this theme wants is the inset one on #entry:selected below. */
  outline: none;
  min-height: 0;
  font-family: {{mono_font}}, JetBrains Mono, monospace;
  font-size: 14px;
  padding: 0;
  background-color: transparent;
}

#window {
  background-color: @bg;
  border: 1px solid @surface;
  border-radius: 12px;
  padding: 0px;
}

#input {
  color: @accent;
  background-color: @surface;
  border: none;
  border-radius: 12px 12px 0 0;
  padding: 8px 12px;
  /* Adwaita rings a focused GtkEntry with its own stock-blue box-shadow, which
   * `border: none` does not touch. Clear it and reuse the entry ring instead,
   * so the focused search bar and the selected entry read as one thing. */
  box-shadow: none;
}

#input:focus {
  box-shadow: inset 0 0 0 1px @accent;
}

#scroll #inner-box {
  background: transparent;
}

#entry {
  color: @fg;
  background: transparent;
  padding: 0.6rem 1rem;
  margin: 2px 5px 5px 5px;
}

#entry:focus {
  color: @fg;
}

#entry:selected {
  color: @accent;
  background-color: @surface;
  /* GTK paints the focus ring as a dashed square outline and ignores any
   * radius set on it, so it never matched the entry fill (8px, from *).
   * Drop the outline and draw the ring as an inset shadow: box-shadow is
   * clipped by border-radius, so ring and fill share one corner. */
  outline: none;
  border-radius: 8px;
  box-shadow: inset 0 0 0 1px @accent;
}

#unselected {
  color: @dim;
}

#img {
  margin-right: 6px;
  margin-left: 0px;
}

# fcitx5 classicui template (§6b) -> ~/.config/fcitx5/conf/classicui.conf.
# Selects the theme rendered from fcitx5/theme.conf.tmpl; the font here is what
# the candidate list uses when the theme does not override it.
Font="{{ui_font}}"
MenuFont="{{ui_font}}"
TrayFont="{{ui_font}}"
TrayOutlineColor=#000000
TrayTextColor={{foreground}}
PreferTextIcon=False
ShowLayoutNameInIcon=True
UseInputMethodLanguageToDisplayText=True
Theme=osr
DarkTheme=osr
UseDarkTheme=True
UseAccentColor=True
PerScreenDPI=True

; qt5ct.conf — theme-owned, rendered per theme (§6b), the Qt5 twin of qt6ct.conf.
; QT_QPA_PLATFORMTHEME can only name one plugin, and the xprofile layer sets
; `qt5ct`: the qt6ct plugin registers that key as well as its own and still reads
; ~/.config/qt6ct, while the Qt5 plugin answers to nothing else. So both files
; are live at once, one per Qt version, and the palette is identical either way.
;
; Fusion + a custom palette rather than Kvantum: none of the rose Kvantum themes
; are packaged on Void, and Fusion honours a palette file exactly.

[Appearance]
style=Fusion
color_scheme_path=~/.config/qt5ct/colors/rice.conf
custom_palette=true
icon_theme=Papirus-Dark
standard_dialogs=gtk3

[Fonts]
fixed="{{mono_font}},{{ui_font_size}},-1,5,50,0,0,0,0,0"
general="{{ui_font_family}},{{ui_font_size}},-1,5,50,0,0,0,0,0"

[Interface]
activate_item_on_single_click=1
buttonbox_layout=0
cursor_flash_time=1000
dialog_buttons_have_icons=1
double_click_interval=400
gui_effects=@Invalid()
keyboard_scheme=2
menus_have_icons=true
show_shortcuts_in_context_menus=true
stylesheets=@Invalid()
toolbutton_style=4
underline_shortcut=1
wheel_scroll_lines=3

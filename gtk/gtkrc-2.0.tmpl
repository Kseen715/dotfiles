# GTK2 rc template — the same names settings.ini carries, in the syntax GTK2
# wants. Rendered per theme (§6b) to ~/.gtkrc-2.0; still needed because a few
# apps (older Wine dialogs, some Java toolkits) have no GTK3 build.
gtk-theme-name="{{gtk_theme}}"
gtk-icon-theme-name="{{icon_theme}}"
gtk-cursor-theme-name="{{cursor_theme}}"
gtk-cursor-theme-size={{cursor_size}}
gtk-font-name="{{ui_font}}"
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
gtk-menu-images=1
gtk-button-images=1

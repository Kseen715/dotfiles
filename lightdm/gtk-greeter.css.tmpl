/* gtk-greeter.css — theme-owned, rendered per theme (§6b), installed by
 * modules/lightdm.sh into the GREETER USER's GTK config
 * (/var/lib/lightdm/.config/gtk-3.0/gtk.css), not into ~/.config.
 *
 * lightdm-gtk-greeter has no `css =` key: the only way to paint it beyond the
 * `theme-name` it inherits is the user CSS GTK3 loads out of $HOME/.config for
 * whatever user the greeter runs as. That is why this file exists as a second
 * layer beside lightdm-gtk-greeter.conf instead of being folded into it.
 *
 * Widget names below are the greeter's own (lightdm-gtk-greeter.ui): #panel_window
 * is the top bar, #login_window the centred prompt, and both are plain GTK
 * widgets — anything unstyled here falls back to {{gtk_theme}}.
 */

@define-color osr_bg           {{background}};
@define-color osr_bg_sunken    {{background_sunken}};
@define-color osr_panel        {{panel_background}};
@define-color osr_surface      {{surface_mid}};
@define-color osr_border       {{border}};
@define-color osr_fg           {{foreground}};
@define-color osr_fg_dim       {{text_muted}};
@define-color osr_accent       {{accent}};
@define-color osr_error        {{error}};

* {
    font-family: "{{ui_font_family}}";
    font-size: {{ui_font_size}}pt;
}

/* --- the top panel (host, clock, session + power indicators) --------------- */
#panel_window {
    /* Transparent, not a filled bar with a rule under it. The wallpaper is the
     * background now, and a solid strip across the top of it is the single
     * thing that makes a greeter look like a utility rather than a desktop.
     * The text keeps a shadow so it stays legible over a light wallpaper. */
    background-color: transparent;
    color: @osr_fg;
    border-bottom: none;
    font-weight: 500;
    text-shadow: 0 1px 3px alpha(#000000, 0.6);
    padding: 6px 10px;
}

#panel_window menubar,
#panel_window menubar > menuitem {
    background-color: transparent;
    color: @osr_fg;
}

#panel_window menubar > menuitem {
    border-radius: 6px;
    padding: 4px 10px;
}

#panel_window menubar > menuitem:hover {
    background-color: @osr_accent;
    color: @osr_bg;
}

#panel_window menu {
    background-color: @osr_panel;
    color: @osr_fg;
    border: 1px solid @osr_border;
}

#panel_window menu menuitem:hover {
    background-color: @osr_accent;
    color: @osr_bg;
}

/* The clock is the headline, exactly as on the lock screen (i3lock draws a
 * 120px %H:%M with the date under it). The greeter has no way to place a label
 * in the middle of the screen - the only text widget it owns is this panel
 * indicator - so the size comes from the Pango markup in clock-format and this
 * rule only removes the panel-item chrome around it. */
#clock_label {
    color: @osr_fg;
    font-weight: 400;
    padding: 10px 0px;
    text-shadow: 0 2px 8px alpha(#000000, 0.55);
}

/* --- the login prompt ------------------------------------------------------ */
/* One floating card, sized generously and lifted off the wallpaper with a real
 * shadow. The translucency is what ties it to the image behind it - fully
 * opaque reads as a dialog sitting on a photo, rather than part of the scene. */
#login_window,
#shutdown_dialog,
#restart_dialog {
    background-color: alpha(@osr_bg, 0.72);
    border: 1px solid alpha(@osr_fg, 0.10);
    border-radius: 18px;
    color: @osr_fg;
    padding: 28px 32px;
    box-shadow: 0 18px 48px alpha(#000000, 0.55);
}

#content_frame {
    padding-bottom: 18px;
}

#login_window entry {
    background-color: alpha(@osr_bg_sunken, 0.85);
    color: @osr_fg;
    caret-color: @osr_accent;
    border: 1px solid alpha(@osr_fg, 0.12);
    border-radius: 10px;
    padding: 10px 14px;
    min-height: 34px;
}

/* A ring rather than just a recoloured border: at this size a 1px colour change
 * is not visible enough to answer "is the password field focused". */
#login_window entry:focus {
    border-color: @osr_accent;
    box-shadow: 0 0 0 2px alpha(@osr_accent, 0.35);
}

#login_window button,
#buttonbox_frame button {
    background-image: none;
    background-color: alpha(@osr_surface, 0.85);
    color: @osr_fg;
    border: 1px solid alpha(@osr_fg, 0.12);
    border-radius: 10px;
    padding: 8px 20px;
    font-weight: 500;
}

#login_window button:hover,
#buttonbox_frame button:hover {
    background-color: @osr_accent;
    color: @osr_bg;
    border-color: @osr_accent;
}

#login_window button:active,
#buttonbox_frame button:active {
    background-color: shade(@osr_accent, 0.85);
    color: @osr_bg;
}

/* The greeter reuses one label for "Incorrect password" and the session hint. */
#login_window label {
    color: @osr_fg_dim;
}

#login_window #user_combo {
    color: @osr_fg;
}

#user_image {
    border: 2px solid @osr_accent;
    border-radius: 50%;
    padding: 3px;
    min-width: 76px;
    min-height: 76px;
    margin-bottom: 10px;
    box-shadow: 0 6px 18px alpha(#000000, 0.45);
}

/* Wrong password / PAM failure. */
#login_window .lightdm-gtk-greeter-error,
#login_window label.error {
    color: @osr_error;
}

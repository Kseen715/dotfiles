# KDE color scheme template (§6b) -> ~/.local/share/color-schemes/os-rice.colors,
# the palette every KDE/Qt app (Kate, Dolphin, Okular) reads once it is selected
# in Plasma's Colors KCM or via qt6ct.
#
# File basename, [General] ColorScheme and [General] Name are all `os-rice` on
# purpose. An app records the scheme it uses under whichever of the three it
# treats as the id (Kate writes `BreezeDark` for a scheme named "Breeze Dark",
# which is both the basename AND the name with its spaces removed), so keeping
# them identical - and free of the theme's display name, which changes on every
# rice switch - is what lets kate/katerc name the scheme statically.
#
# The two literal Color= values in [ColorEffects:*] are Breeze's disabled and
# inactive TINTS, not palette entries - they are the same grey whatever the
# theme, which is why they are the only numbers left in here.
[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65000000000000002
ContrastEffect=1
IntensityAmount=0.10000000000000001
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025000000000000001
ColorEffect=2
ContrastAmount=0.10000000000000001
ContrastEffect=2
Enable=true
IntensityAmount=0
IntensityEffect=0


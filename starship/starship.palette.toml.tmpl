# starship palette template — the ONE starship color layer, rendered per theme
# (§6b) and composed onto the shared base (starship/starship.toml). Prompt
# structure and symbols live in the base; only these four colors are theme-owned.
[palettes.theme]
accent = "{{accent}}"
success = "{{success}}"
error = "{{error}}"
secondary = "{{prompt_secondary}}"
